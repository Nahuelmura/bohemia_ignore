@{
    ViewData["Title"] = "Cobros";
}

<body class="Fondo_cobro">

    <h1 class="Textobohemia" style="text-align: center ;">Cobros </h1>



    <h6 class="Textobohemia text-center mb-4">
        En esta sección usted podrá ingresar los cobros por cliente.
    </h6>

    <div class="container cobros-dark">

        <input type="hidden" id="CobroID" value="0">
        <input type="hidden" id="ClienteID" value="0">

        <!-- ================= FORMULARIO ================= -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label Textobohemia" style="color:white ;">Monto del cobro</label>
                <input type="text" class="form-control" id="monto" placeholder="Ej: 300000">
            </div>

            <div class="col-md-4">
                <label class="form-label Textobohemia" style="color:white ;">Forma de Cobro</label>
                @Html.DropDownList(
                "FormaCobro",
                                (IEnumerable<SelectListItem>)ViewBag.FormaCobro,
                                new { @class = "form-control select2" }
                                )
            </div>

            <div class="col-md-4">
                <label class="form-label Textobohemia" style="color:white ;">Fecha de Cobro</label>
                <input type="date" class="form-control" id="fecha" style=";">
            </div>
        </div>

        <!-- ================= CLIENTE + DATOS (MISMA ALTURA) ================= -->
        <div class="row mb-4 align-items-end ">

            <div class="col-md-2 position-relative">
                <label class="form-label Textobohemia" style="color:white ;">Cliente</label>
                <input type="text" id="Nombre" class="form-control" placeholder="Nombre del cliente" autocomplete="off">

                <ul id="sugerenciasClientes" class="list-group position-absolute w-100 color_Fondo_Sugerencias"
                    style="z-index:1050; display:none;">
                </ul>
            </div>

            <div class="col-md-2">
                <label class="form-label Textobohemia" style="color:white ;">Localidad</label>
                <input type="text" id="Localidad" class="form-control" readonly>
            </div>

            <div class="col-md-2">
                <label class="form-label Textobohemia" style="color:white ;">Teléfono</label>
                <input type="text" id="Telefono" class="form-control" readonly>
            </div>

            <div class="col-md-2">
                <label class="form-label Textobohemia" style="color:white ;">DNI / CUIL</label>
                <input type="text" id="Dni" class="form-control" readonly>
            </div>


            <div class="col-md-4  mt-3 ms-auto">
                <button class="btn btn-outline-dark w-100" onclick="GuardarCobro()">
                    Guardar Cobro
                </button>
            </div>
        </div>

        <!-- ================= GUARDAR ================= -->


        <!-- ================= FILTROS ================= -->
        <div class="filtro-clientes-cobro mb-4">
            <div class="row">
                <div class="col-md-3">
                    <label class="Textobohemia text-white">Buscar Cliente</label>
                    <input class="form-control" id="txtBuscarCliente"
                        placeholder="Buscar por nombre ej: Nahuel Maidana">
                </div>

                <div class="col-md-3">
                    <label class="Textobohemia text-white">Fecha Desde</label>
                    <input type="date" class="form-control" id="FechaDesde">
                </div>

                <div class="col-md-3">
                    <label class="Textobohemia text-white">Fecha Hasta</label>
                    <input type="date" class="form-control" id="FechaHasta">
                </div>

                <div class=" col-md-3">
                    <label class="  Textobohemia text-white">Forma de cobro</label>

                    @Html.DropDownList(
                                        "cobroID",
                                        (IEnumerable<SelectListItem>)ViewBag.FormaCobro, // 👈 CORRECTO
                                        new { @class = "form-control", id = "cobroID" }
                                        )
                </div>
            </div>
        </div>


        <!-- ================= TABLA ================= -->
        <div class="table-responsive">
            <table class="table table-hover table-dark table-sm">
                <thead>
                    <tr>

                        <th class="Textobohemia-tabla">Nombre cliente</th>
                        <th class="ocultar-en-768px Textobohemia-tabla">Fecha</th>
                        <th class="Textobohemia-tabla">Teléfono</th>
                        <th class="ocultar-en-768px Textobohemia-tabla">Forma de cobro</th>
                        <th class="Textobohemia-tabla">Monto</th>
                   
                      
                     
                    </tr>
                </thead>
                <tbody id="tbody-cobro"></tbody>
            </table>
        </div>

    </div>

    @section Scripts {
        <script src="~/js/Cobro.1.0.0.js"></script>
    }


    <!-- ================= MODAL CUOTAS ================= -->
<div class="modal fade" id="modalCuotas" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content cobros-dark">

      <div class="modal-header">
        <h5 class="modal-title Textobohemia">Registrar Plan de Cuotas</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <div class="row mb-3">
          <div class="col-md-4">
            <label class="Textobohemia text-white">Cantidad de Cuotas</label>
            <input type="number" id="cantidadCuotas" class="form-control" min="1" value="1">
          </div>

          <div class="col-md-4">
            <label class="Textobohemia text-white">Monto Total</label>
            <input type="text" id="montoTotalCuotas" class="form-control" readonly>
          </div>

          <div class="col-md-4">
            <label class="Textobohemia text-white">Primer Vencimiento</label>
            <input type="date" id="primerVencimiento" class="form-control">
          </div>
        </div>

        <div id="detalleCuotas"></div>

      </div>

      <div class="modal-footer">
        <button class="btn btn-success" onclick="GuardarPlanCuotas()">Guardar Plan</button>
      </div>

    </div>
  </div>
</div>



<!-- ================= MODAL CHEQUE ================= -->
<div class="modal fade" id="modalCheque" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content cobros-dark">

            <div class="modal-header">
                <h5 class="modal-title Textobohemia">Registrar Cheque</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body row">

                <div class="mb-3 ">
                    <label class="text-white">Banco</label>
                    <input type="text" id="bancoCheque" class="form-control" placeholder="Ej: Banco Nación">
                </div>

                <div class="mb-3 col-md-6">
                    <label class="text-white">Fecha Emisión</label>
                    <input type="date" id="fechaEmisionCheque" class="form-control">
                </div>

                <div class="mb-3 col-md-6">
                    <label class="text-white">Fecha Cobro</label>
                    <input type="date" id="fechaCobroCheque" class="form-control" >
                </div>

                 <div class="mb-3 col-md-6">
                    <label class="text-white">Número de Cheque</label>
                    <input type="text" id="numeroCheque" class="form-control" placeholder="Ej: 12345678">
                </div>

                <div class="mb-3 col-md-6">
                    <label class="text-white">Monto</label>
                    <input type="text" id="montoCheque" class="form-control" readonly>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" onclick="GuardarCheque()">Guardar Cheque</button>
            </div>

        </div>
    </div>
</div>

</body>