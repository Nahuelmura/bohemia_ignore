@{
    ViewData["Title"] = "Home Page";
}

<body class="Fondo_cobro">

<h1 class="tituloCard text-center">Bienvenido a Bohemia Vintage</h1>

<!-- BOTONES DE ACCIÓN -->
<div class="dashboard-actions">
    <a href="/venta" class="action-card">
        <div>
            <h2>Nueva Venta</h2>
            <p>Crear factura o recibo</p>
        </div>
        <div class="action-icon">
            <i class="fa-solid fa-cart-shopping"></i>
        </div>
    </a>

    <a href="/productos" class="action-card">
        <div>
            <h2>Inventario</h2>
            <p>Ver y agregar productos</p>
        </div>
        <div class="action-icon">
            <i class="fa-solid fa-boxes-stacked"></i>
        </div>
    </a>

    <a href="/cobro" class="action-card">
        <div>
            <h2>Cobros</h2>
            <p>Registrar pagos recibidos</p>
        </div>
        <div class="action-icon">
            <i class="fa-solid fa-hand-holding-dollar"></i>
        </div>
    </a>
</div>

<div class="dashboard-columns">

    <!-- VENCIDOS -->
    <div class="card-alert card-alert--danger">
        <div class="card-header">
            <h3><i class="fa-solid fa-triangle-exclamation"></i> Pagos Vencidos</h3>
            <span id="badgeVencidos" class="badge badge-danger">0 Pendientes</span>
        </div>

        <table class="table table-hover" id="tablaVencidos">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th>Tipo</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr class="table-secondary">
                    <th colspan="3" class="text-end">Total:</th>
                    <th id="totalVencidosTabla">$0</th>
                </tr>
            </tfoot>
        </table>
    </div>


    <!-- PRÓXIMOS -->
    <div class="card-alert card-alert--warning">
        <div class="card-header">
            <h3><i class="fa-solid fa-calendar-day"></i> Próximos Cobros (30 días)</h3>
            <span id="badgeProximos" class="badge badge-warning">0 Próximos</span>
        </div>

       <table class="table table-hover" id="tablaProximos">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Monto</th>
            <th>Fecha</th>
            <th>Tipo</th>
        </tr>
    </thead>

    <tbody id="tbodyProximos"></tbody>

    <tfoot>
        <tr class="table-secondary">
            <th colspan="3" class="text-end">Total:</th>
            <th id="totalProximos">$0</th>
        </tr>
    </tfoot>
</table>
    </div>

</div>
<!-- GRÁFICO -->
<div class="chart-card">
    <div class="chart-header">
        <h3>
            <i class="fa-solid fa-chart-line"></i> Ventas Últimos 12 Meses
        </h3>
    </div>
    <div class="chart-container">
        <canvas id="chartpro"></canvas>
    </div>
</div>

</body>

    

  @section Scripts {
    <script src="~/js/InformePro.js"></script>
}