<body class="Fondo_cobro">

<h1 class="Textobohemia text-center">Compras</h1>

<div class="container cobros-dark">

    <!-- ================== DATOS COMPRA ================== -->
    <input type="hidden" id="CompraID" value="0">

    <div class="row mb-4">

        <!-- PROVEEDOR -->
        <div class="col-md-3 position-relative">
            <label class="form-label Textobohemia">Proveedor</label>

            <input type="hidden" id="ProveedorID">

            <input type="text" class="form-control" id="nombre"
                   placeholder="Buscar proveedor...">

            <ul id="sugerenciasProveedores"
                class="position-absolute w-100"
                style="z-index:1000; display:none;">
            </ul>
        </div>

        <!-- MONTO -->
        <div class="col-md-4">
            <label class="form-label Textobohemia">Monto</label>
            <input type="number" class="form-control" id="monto">
        </div>

        <!-- OBS -->
        <div class="col-md-4">
            <label class="form-label Textobohemia">Observación</label>
            <input type="text" class="form-control" id="observacion">
        </div>

    </div>

    <div class="row mb-4">

        <!-- FACTURA -->
        <div class="col-md-4">
            <label class="form-label Textobohemia">Factura</label>
            <input type="number" class="form-control" id="numFactura">
        </div>

        <!-- FECHA -->
        <div class="col-md-4">
            <label class="form-label Textobohemia">Fecha</label>
            <input type="date" class="form-control" id="fechaCompra">
        </div>

        <!-- TIPO -->
        <div class="col-md-4">
            <label class="form-label Textobohemia">Tipo Compra</label>
            @Html.DropDownList("TipoCompra", null,
                new { @class = "form-control" })
        </div>

    </div>

    <!-- ================== DETALLE ================== -->
    <div class="row">

        <!-- PRODUCTO -->
        <div class="col-md-4 position-relative">
            <label class="form-label Textobohemia">Producto</label>

            <input type="hidden" id="ProductoID">

            <input type="text" class="form-control" id="codigo"
                   placeholder="Buscar producto">

            <ul id="sugerenciasProducto"
                class="list-group position-absolute w-100"
                style="z-index:1000; display:none;">
            </ul>
        </div>

        <!-- CANTIDAD -->
        <div class="col-md-4">
            <label class="form-label Textobohemia">Cantidad</label>
            <input type="number" class="form-control" id="cantidad">
        </div>

        <!-- PRECIO -->
        <div class="col-md-4">
            <label class="form-label Textobohemia">Precio Unitario</label>
            <input type="number" class="form-control" id="precioUnitario">
        </div>

        <!-- BOTÓN AGREGAR -->
        <div class="col-md-4 mt-3">
            <button class="btn btn-primary w-100" onclick="AgregarProducto()">
                ➕ Agregar Producto
            </button>
        </div>

    </div>

    <!-- ================== TABLA DETALLE ================== -->
    <div class="table-responsive mt-4">
        <table class="table table-dark table-sm">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Eliminar</th>
                    
                </tr>
                
            </thead>
            <tbody id="tablaDetalle"></tbody>
        </table>
            <div class="text-end mt-2">
                <h5>Total:  <span id="totalCompra">$ 0</span></h5>
            </div>

    </div>

    <!-- BOTÓN FINAL -->
    <div class="mt-3">
        <button class="btn btn-success w-100" onclick="GuardarTodo()">
            💾 Guardar Compra
        </button>
    </div>

</div>




</div>

<!-- ================== TABLA DETALLE ================== -->
<div class="container">
    
    <div class=" mt-4 px-4 cobros-dark">
        
        <h5 class="mb-3 Textobohemia">Listado de Compras</h5>

        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-dark table-sm table-hover align-middle mb-0">
                <thea style="position: sticky; top: 0; z-index: 2;">
                    <tr>
                        <th></th>
                        <th class="Textobohemia">Nombre Proveedor</th>
                        <th class="Textobohemia">Monto Compra</th>
                        <th class="Textobohemia">Observación</th>
                        <th class="Textobohemia">Factura</th>
                        <th class="Textobohemia">Fecha</th>
                        <th class="Textobohemia">Tipo Compra</th>
                    </tr>
                </thea>
                <tbody id="detalleCompra"></tbody>
            </table>
        </div>

    </div>

</div>



        @section Scripts {
            <script src="~/js/Compra1.0.0.js"></script>
        }

    </body>